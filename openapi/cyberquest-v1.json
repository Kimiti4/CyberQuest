{
  "openapi": "3.1.0",
  "info": {
    "title": "CYBERQUEST API",
    "version": "1.0.0",
    "description": "Proposed contract only. No runtime implementation is implied."
  },
  "servers": [
    {
      "url": "https://api.example.invalid",
      "description": "Placeholder; replace before deployment"
    },
    {
      "url": "http://localhost:8000",
      "description": "Local development placeholder"
    }
  ],
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Learning catalogue"
    },
    {
      "name": "Mission attempts"
    },
    {
      "name": "Learner progress"
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Process liveness",
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "description": "Process is responding",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Dependency readiness",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Dependencies are ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "One or more required dependencies are unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/learning-paths": {
      "get": {
        "tags": [
          "Learning catalogue"
        ],
        "summary": "List published learning paths",
        "operationId": "listLearningPaths",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Published learning paths",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearningPathList"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/missions/{missionId}": {
      "get": {
        "tags": [
          "Learning catalogue"
        ],
        "summary": "Get a published mission summary",
        "operationId": "getMission",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "missionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published mission summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MissionSummary"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Mission not found or not published",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/mission-attempts": {
      "post": {
        "tags": [
          "Mission attempts"
        ],
        "summary": "Start an attempt against the current published mission version",
        "operationId": "createMissionAttempt",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMissionAttempt"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Attempt created or idempotently replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MissionAttempt"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Mission unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency key conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/mission-attempts/{attemptId}/events": {
      "post": {
        "tags": [
          "Mission attempts"
        ],
        "summary": "Submit a learner choice/evidence event for evaluation",
        "operationId": "submitMissionEvent",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "attemptId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MissionEvent"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Event accepted for deterministic evaluation; acceptance is not completion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Attempt belongs to another learner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Attempt or stage not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Stale version or conflicting replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/mission-attempts/{attemptId}": {
      "get": {
        "tags": [
          "Mission attempts"
        ],
        "summary": "Get the authenticated learner's attempt status",
        "operationId": "getMissionAttempt",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "attemptId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Attempt state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MissionAttempt"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Attempt belongs to another learner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Attempt not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me/progress": {
      "get": {
        "tags": [
          "Learner progress"
        ],
        "summary": "Get the authenticated learner's progress summary",
        "operationId": "getMyProgress",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Progress summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProgressSummary"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token issuer and claims are TBD; validate issuer, audience, expiry and subject server-side."
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "LearningPath": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "LearningPathList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningPath"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "MissionSummary": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "version",
          "difficulty"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          },
          "estimated_minutes": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "CreateMissionAttempt": {
        "type": "object",
        "required": [
          "mission_id"
        ],
        "properties": {
          "mission_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "MissionAttempt": {
        "type": "object",
        "required": [
          "id",
          "mission_id",
          "mission_version",
          "status",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "mission_id": {
            "type": "string",
            "format": "uuid"
          },
          "mission_version": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "submitted",
              "evaluated",
              "abandoned"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MissionEvent": {
        "type": "object",
        "required": [
          "event_id",
          "stage_id",
          "choice_id"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "stage_id": {
            "type": "string",
            "maxLength": 100
          },
          "choice_id": {
            "type": "string",
            "maxLength": 100
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "EventReceipt": {
        "type": "object",
        "required": [
          "event_id",
          "status"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted_for_evaluation"
            ]
          }
        }
      },
      "ProgressSummary": {
        "type": "object",
        "required": [
          "learner_id",
          "xp_total",
          "completed_missions"
        ],
        "properties": {
          "learner_id": {
            "type": "string",
            "format": "uuid"
          },
          "xp_total": {
            "type": "integer",
            "minimum": 0
          },
          "completed_missions": {
            "type": "integer",
            "minimum": 0
          },
          "competency_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
